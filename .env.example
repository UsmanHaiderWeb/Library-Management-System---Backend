DATABASE_URL=mysql://root:password@localhost:3306/lmsbackend
PORT=3000
JWT_SECRET=your-jwt-secret-min-10-chars
Session_Secret=your-session-secret-min-10-chars
REDIS_URL=redis://localhost:6379
NODE_ENV=development
# A fixed email-verification code, so local work and demos are not blocked on
# a working mail server. Requires NODE_ENV=development as well -- two switches,
# because NODE_ENV defaults to 'development' and one alone would mean any
# install that forgot to set it shipped a working backdoor. Never set this in
# production.
# DEV_OTP_CODE=000000

FRONTEND_URL=http://localhost:5173

# Browser origins allowed to call this API (comma-separated). Leave unset in
# development — the default covers both portals on 5173/5174 (dev) and
# 4173/4174 (vite preview). Set it per install, e.g.
# CORS_ORIGINS=https://library.yourcollege.edu.pk,https://admin.yourcollege.edu.pk
# CORS_ORIGINS=

# Used by docker-compose.yml to provision MySQL.
# MYSQL_ROOT_PASSWORD must match the password inside DATABASE_URL above,
# and MYSQL_DATABASE must match its database name.
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=lmsbackend

# Email (SMTP)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# ImageKit (optional)
IMAGE_KIT_URL=https://ik.imagekit.io/your-id
IMAGE_KIT_PUBLIC_KEY=your-public-key
IMAGE_KIT_PRIVATE_KEY=your-private-key
