DATABASE_URL=mysql://user:password@localhost:3306/lmsbackend
PORT=3000
JWT_SECRET=your-jwt-secret-min-10-chars
Session_Secret=your-session-secret-min-10-chars
REDIS_URL=redis://localhost:6379
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Email (SMTP)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# ImageKit (optional)
IMAGE_KIT_URL=https://ik.imagekit.io/your-id
IMAGE_KIT_PUBLIC_KEY=your-public-key
IMAGE_KIT_PRIVATE_KEY=your-private-key
