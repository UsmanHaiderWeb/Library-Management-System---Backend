DATABASE_URL=mysql://root:password@localhost:3306/lmsbackend
PORT=3000
JWT_SECRET=your-jwt-secret-min-10-chars
Session_Secret=your-session-secret-min-10-chars
REDIS_URL=redis://localhost:6379
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Used by docker-compose.yml to provision MySQL.
# MYSQL_ROOT_PASSWORD must match the password inside DATABASE_URL above,
# and MYSQL_DATABASE must match its database name.
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=lmsbackend

# Email (SMTP)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# ImageKit (optional)
IMAGE_KIT_URL=https://ik.imagekit.io/your-id
IMAGE_KIT_PUBLIC_KEY=your-public-key
IMAGE_KIT_PRIVATE_KEY=your-private-key
