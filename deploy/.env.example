# Production environment for docker-compose.prod.yml.
# Copy to .env in this directory and fill in. Never commit the filled copy.

# ---------------------------------------------------------------- identity
# The three values that make this install belong to one college.
COLLEGE_CODE=GICCL
COLLEGE_NAME=Government Islamia College
STUDENT_HOST=library.example.edu.pk
ADMIN_HOST=admin.library.example.edu.pk
# Where Let's Encrypt sends expiry warnings if renewal ever fails.
ACME_EMAIL=you@example.com

# No domain yet? sslip.io resolves to the IP inside the hostname and still
# gets a real certificate, so a demo can go live before DNS is arranged:
#   STUDENT_HOST=library.203.0.113.5.sslip.io
#   ADMIN_HOST=admin.203.0.113.5.sslip.io

# ---------------------------------------------------------------- database
# DATABASE_URL and REDIS_URL are set by the compose file to the container
# hostnames — do not set them here. Only the password and database name.
MYSQL_ROOT_PASSWORD=change-me-to-something-long
MYSQL_DATABASE=lmsbackend

# ---------------------------------------------------------------- secrets
# Generate each with:  openssl rand -base64 48
JWT_SECRET=
Session_Secret=

# ---------------------------------------------------------------- email
# Students cannot verify their own email without working SMTP. Signup no
# longer fails when mail is down, so the symptom is silent: the code simply
# never arrives. Use a transactional provider (Brevo, Zoho, SES) rather than a
# college mailbox, and send yourself a test signup before handing over.
EMAIL_USER=
EMAIL_PASS=

# ---------------------------------------------------------------- uploads
# Book covers and PDFs. Without these, cover upload fails in the admin portal.
IMAGE_KIT_URL=https://ik.imagekit.io/your-id
IMAGE_KIT_PUBLIC_KEY=
IMAGE_KIT_PRIVATE_KEY=

# ---------------------------------------------------------------- optional
# Links inside notification emails.
FRONTEND_URL=https://library.example.edu.pk
# Both portals are same-origin with the API behind Caddy, so CORS does not
# apply to them. Only set this if something else calls the API from a browser.
# CORS_ORIGINS=
