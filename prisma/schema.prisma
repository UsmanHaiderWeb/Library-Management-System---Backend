generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model College {
  id               String             @id @default(uuid())
  name             String             @db.VarChar(100)
  code             String             @unique @db.VarChar(10)
  createdAt        DateTime           @default(now())
  admins           Admin[]
  books            Book[]
  borrowBooks      BorrowedBook[]
  borrowRequests   BorrowedRequests[]
  purchaseRequests PurchaseRequest[]
  users            User[]
}

model Book {
  id               String             @id @default(uuid())
  bookNumber       String             @db.Text
  bookName         String             @db.Text
  summary          String             @db.LongText
  author           String             @db.VarChar(50)
  genre            String             @db.LongText
  image            String             @db.LongText
  bgColor          String             @db.VarChar(9)
  totalBooks       Int
  almirahNumber    Int                @db.MediumInt
  shelfNumber      Int                @db.MediumInt
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  isOnline         Boolean            @default(false)
  onlineFileUrl    String?            @db.LongText
  collegeId        String?
  College          College?           @relation(fields: [collegeId], references: [id])
  copies           BookCopy[]
  BorrowedRequests BorrowedRequests[]
  reviews          Review[]
  savedBooks       SavedBook[]

  @@index([id, collegeId])
  @@index([collegeId], map: "Book_collegeId_fkey")
}

model BookCopy {
  id           String         @id @default(uuid())
  bookId       String
  isBorrowed   Boolean        @default(false)
  book         Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  borrowedBook BorrowedBook[]

  @@index([id, bookId])
  @@index([bookId], map: "BookCopy_bookId_fkey")
}

model User {
  id                 String              @id @default(uuid())
  name               String              @db.VarChar(25)
  studentId          String              @db.VarChar(10)
  email              String              @unique
  isEmailVerified    Boolean             @default(false)
  password           String              @db.VarChar(150)
  phoneNumber        String?             @db.VarChar(13)
  isVerifiedByAdmin  Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  batchYear          Int?
  collegeId          String?
  fineBalance        Int                 @default(0)
  role               UserRole            @default(STUDENT)
  passwordResetRetries   Int             @default(0)
  passwordResetLastRetry DateTime?
  borrowedBooks      BorrowedBook[]
  borrowedRequests   BorrowedRequests[]
  purchaseRequests   PurchaseRequest[]
  College            College?            @relation(fields: [collegeId], references: [id])
  verificationTokens VerificationToken[]
  ipAddressess       ipAddressess[]
  reviews            Review[]
  savedBooks         SavedBook[]
  notifications      Notification[]

  @@index([batchYear, isVerifiedByAdmin, id, email, collegeId, role])
  @@index([collegeId], map: "User_collegeId_fkey")
}

model Admin {
  id                 String              @id @default(uuid())
  name               String              @db.VarChar(25)
  email              String              @unique
  password           String              @db.VarChar(150)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  passwordResetRetries   Int             @default(0)
  passwordResetLastRetry DateTime?
  collegeId          String
  College            College             @relation(fields: [collegeId], references: [id])
  verificationTokens VerificationToken[]

  @@index([id, email, collegeId])
  @@index([collegeId], map: "Admin_collegeId_fkey")
}

model BorrowedBook {
  id         String             @id @default(uuid())
  bookCopyId String
  userId     String
  borrowedOn DateTime           @default(now())
  dueDate    DateTime?
  returnedOn DateTime?
  status     BorrowedBookStatus @default(borrowed)
  collegeId  String?
  bookCopy   BookCopy           @relation(fields: [bookCopyId], references: [id], onDelete: Cascade)
  College    College?           @relation(fields: [collegeId], references: [id])
  user       User               @relation(fields: [userId], references: [id])

  @@index([id, userId, bookCopyId, collegeId])
  @@index([bookCopyId], map: "BorrowedBook_bookCopyId_fkey")
  @@index([collegeId], map: "BorrowedBook_collegeId_fkey")
  @@index([userId], map: "BorrowedBook_userId_fkey")
}

model BorrowedRequests {
  id          String              @id @default(uuid())
  bookId      String
  userId      String
  requestedOn DateTime            @default(now())
  status      BorrowRequestStatus @default(pending)
  collegeId   String?
  book        Book                @relation(fields: [bookId], references: [id], onDelete: Cascade)
  College     College?            @relation(fields: [collegeId], references: [id])
  user        User                @relation(fields: [userId], references: [id])

  @@index([userId, bookId, id, status])
  @@index([bookId], map: "BorrowedRequests_bookId_fkey")
  @@index([collegeId], map: "BorrowedRequests_collegeId_fkey")
}

model PurchaseRequest {
  id          String                @id @default(uuid())
  bookTitle   String                @db.VarChar(200)
  author      String?               @db.VarChar(100)
  reason      String?               @db.Text
  status      PurchaseRequestStatus @default(PENDING)
  userId      String
  collegeId   String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  College     College?              @relation(fields: [collegeId], references: [id])
  requestedBy User                  @relation(fields: [userId], references: [id])

  @@index([userId, collegeId, status])
  @@index([collegeId], map: "PurchaseRequest_collegeId_fkey")
}

model VerificationToken {
  id        String    @id @default(uuid())
  token     String    @db.VarChar(250)
  userId    String?
  type      TokenType @default(EMAIL_VERIFICATION)
  expiresAt DateTime
  adminId   String?
  admin     Admin?    @relation(fields: [adminId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])

  @@index([userId, adminId, type, id])
  @@index([adminId], map: "VerificationToken_adminId_fkey")
}

model ipAddressess {
  id         String  @id @default(uuid())
  ipAddress  String  @db.VarChar(40)
  isVerified Boolean @default(false)
  userId     String
  user       User    @relation(fields: [userId], references: [id])

  @@index([userId, id, ipAddress])
}

enum UserRole {
  STUDENT
  FACULTY
  STAFF
}

enum BorrowedBookStatus {
  borrowed
  returned
}

enum BorrowRequestStatus {
  pending
  accepted
  rejected
}

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model Review {
  id        String   @id @default(uuid())
  bookId    String
  userId    String
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookId, userId])
}

model SavedBook {
  id        String   @id @default(uuid())
  bookId    String
  userId    String
  createdAt DateTime @default(now())
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId, bookId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}
