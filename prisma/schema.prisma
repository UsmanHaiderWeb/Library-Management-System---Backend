// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

model College {
    id        String   @id @default(uuid())
    name      String   @db.VarChar(100)
    code      String   @unique @db.VarChar(10) // e.g., GCUF, UCP
    admins    Admin[]
    users     User[]
    books     Book[]
    createdAt DateTime @default(now())
}

model Book {
    id               String             @id @default(uuid())
    bookName         String             @db.Text
    author           String             @db.VarChar(50)
    genre            String             @db.LongText
    image            String             @db.LongText
    bgColor          String             @db.VarChar(9)
    totalBooks       Int
    createdAt        DateTime           @default(now())
    updatedAt        DateTime           @updatedAt
    isOnline         Boolean            @default(false) // new
    onlineFileUrl    String?            @db.LongText // optional: PDF / epub / link
    copies           BookCopy[]
    BorrowedRequests BorrowedRequests[]
    College          College?           @relation(fields: [collegeId], references: [id])
    collegeId        String?

    @@index([id, collegeId])
}

model BookCopy {
    id           String         @id @default(uuid())
    bookId       String
    book         Book           @relation(fields: [bookId], references: [id])
    isBorrowed   Boolean        @default(false)
    borrowedBook BorrowedBook[]

    @@index([id, bookId])
}

model User {
    id                 String              @id @default(uuid())
    name               String              @db.VarChar(25)
    studentId          String              @db.VarChar(10)
    email              String              @unique
    isEmailVerified    Boolean             @default(false)
    password           String              @db.VarChar(150)
    phoneNumber        String?             @db.VarChar(13)
    isVerifiedByAdmin  Boolean             @default(false)
    createdAt          DateTime            @default(now())
    updatedAt          DateTime            @updatedAt
    batchYear          Int?
    borrowedBooks      BorrowedBook[] // one-to-many relation
    borrowedRequests   BorrowedRequests[]
    verificationTokens VerificationToken[]
    ipAddressess       ipAddressess[]
    College            College?            @relation(fields: [collegeId], references: [id])
    collegeId          String?

    @@index([batchYear, isVerifiedByAdmin, id, email, collegeId])
}

model Admin {
    id        String   @id @default(uuid())
    name      String   @db.VarChar(25)
    email     String   @unique
    password  String   @db.VarChar(150)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    collegeId String
    College   College  @relation(fields: [collegeId], references: [id])

    @@index([id, email, collegeId])
}

model BorrowedBook {
    id         String    @id @default(uuid())
    bookCopyId String
    bookCopy   BookCopy  @relation(fields: [bookCopyId], references: [id])
    userId     String
    user       User      @relation(fields: [userId], references: [id])
    borrowedOn DateTime  @default(now())
    dueDate    DateTime?
    returnedOn DateTime?
    status     String    @db.VarChar(15)

    @@index([id, userId, bookCopyId])
}

model BorrowedRequests {
    id          String   @id @default(uuid())
    bookId      String
    book        Book     @relation(fields: [bookId], references: [id])
    userId      String
    user        User     @relation(fields: [userId], references: [id])
    requestedOn DateTime @default(now())
    status      String   @db.VarChar(15)

    @@index([userId, bookId, id])
}

model VerificationToken {
    id        String    @id @default(uuid())
    token     String    @db.VarChar(250) // six-digit code or verification link
    userId    String
    user      User      @relation(fields: [userId], references: [id])
    type      TokenType @default(EMAIL_VERIFICATION) // or PASSWORD_RESET
    expiresAt DateTime

    @@index([userId, type, id])
}

enum TokenType {
    EMAIL_VERIFICATION
    PASSWORD_RESET
}

model ipAddressess {
    id         String  @id @default(uuid())
    ipAddress  String  @db.VarChar(40)
    isVerified Boolean @default(false)
    userId     String
    user       User    @relation(fields: [userId], references: [id])

    @@index([userId, id, ipAddress])
}
